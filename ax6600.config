#
# AX6600 (JDCloud RE-CS-02) + Docker + ksmbd + 无代理 最终稳定版
# 目标：GitHub Actions 稳定编译通过，固件精简够用
# 相对上一版改动：
#   1. samba4 全家桶 → ksmbd（固件小 5-8MB，内存省 20-40MB）
#   2. 去掉 samba4 残留依赖
#   3. 保留 wsdd2（Windows 网络邻居发现）
#   4. 保留 terminfo + libncurses（bash/htop/ttyd 依赖）
#   5. 新增：手机 USB 网络共享支持（Android RNDIS + iPhone ipheth）
#

# ============================================================
# 目标设备（务必保留）
# ============================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# ============================================================
# 基础系统 / 工具
# ============================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_cgdisk=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_curl=y
# ============================================================
# Docker（轻量稳定版）
# ============================================================
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_kmod-veth=y
# Docker 依赖的文件系统
CONFIG_PACKAGE_kmod-fs-overlayfs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_e2fsprogs=y

# ============================================================
# 文件共享（ksmbd 轻量方案，替代 samba4）
# ============================================================
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-utils=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_wsdd2=y

# ============================================================
# 内核模块（按需保留）
# ============================================================
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-xhci=y

# ============================================================
# 手机 USB 网络共享（Android + iPhone）
# ============================================================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

# ============================================================
# 网络 / 服务
# ============================================================
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ============================================================
# LuCI（精简）
# ============================================================
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-proto-relay=y
CONFIG_PACKAGE_luci-theme-argon=y

# 中文翻译
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ============================================================
# 库（基础依赖，别乱砍）
# ============================================================
CONFIG_PACKAGE_libacl=y
CONFIG_PACKAGE_libattr=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libev=y
CONFIG_PACKAGE_libexpat=y
CONFIG_PACKAGE_libltdl=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblzma=y
CONFIG_PACKAGE_liblzo=y
CONFIG_PACKAGE_libmount=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libnl-core=y
CONFIG_PACKAGE_libnl-genl=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libpopt=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libtasn1=y
CONFIG_PACKAGE_libzstd=y

# ============================================================
# cURL（最小可用，OpenSSL 后端）
# ============================================================
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_HTTP2=y
CONFIG_LIBCURL_ZLIB=y

# ============================================================
# 编译优化
# ============================================================
CONFIG_PARTED_READLINE=y
CONFIG_PCRE2_JIT_ENABLED=y
CONFIG_ZSTD_OPTIMIZE_O3=y

# ============================================================
# 以下全部显式关闭（防止 make defconfig 自动拉入）
# ============================================================
# --- 代理全家桶（全关）---
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=n
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_v2ray-plugin=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_haproxy=n
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_dns2socks=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y

# --- samba4（用 ksmbd 替代）---
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_SAMBA4_SERVER_AVAHI=n
CONFIG_SAMBA4_SERVER_NETBIOS=n
CONFIG_SAMBA4_SERVER_VFS=n
CONFIG_SAMBA4_SERVER_WSDD2=n

# --- Docker 重型功能（全关）---
CONFIG_PACKAGE_docker-compose=n
CONFIG_PACKAGE_dockerd-rootless=n
CONFIG_PACKAGE_kmod-br-netfilter=n
CONFIG_PACKAGE_kmod-nf-ipvs=n

# --- 文件系统 / RAID / NVMe ---
CONFIG_PACKAGE_kmod-fs-btrfs=n
CONFIG_PACKAGE_btrfs-progs=n
CONFIG_PACKAGE_kmod-md-mod=n
CONFIG_PACKAGE_kmod-md-raid0=n
CONFIG_PACKAGE_kmod-md-raid1=n
CONFIG_PACKAGE_kmod-md-raid10=n
CONFIG_PACKAGE_mdadm=n
CONFIG_PACKAGE_kmod-nvme=n
CONFIG_PACKAGE_nvme-cli=n
CONFIG_PACKAGE_libnvme=n
CONFIG_PACKAGE_kmod-fs-msdos=n
CONFIG_PACKAGE_kmod-fs-netfs=n
CONFIG_PACKAGE_kmod-fs-smbfs-common=n

# --- USB 网卡（除手机共享外全关）---
# 注意：kmod-usb-net / rndis / cdc-ether / ipheth 已移到上方开启区
CONFIG_PACKAGE_kmod-usb-net-asix=n
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=n
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=n
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=n
