#
# 基础 .config —— JDCloud RE-CS-02 (雅典娜 AX6600) + NSS 满血
# 说明：这份 .config 只是"种子"，diy-part2.sh 会在它基础上追加插件和修正
#       最终由 make defconfig 展开为完整配置
#

# ============ 目标平台 ============
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# ============ NSS 核心（qosmio 分支自带）============
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-ppe=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y

# NSS 固件
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ============ 网络 / 驱动 ============
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-utils=y

# ============ LuCI 基础 ============
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ============ 系统工具 ============
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_sysstat=y

# ============ 磁盘 / 文件系统 ============
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ============ Rust（athena-led 依赖）============
CONFIG_RUST=y

# ============ Athena LED（雅典娜点阵屏）============
CONFIG_PACKAGE_athena-led=y
CONFIG_PACKAGE_luci-app-athena-led=y

# ============ iStore 应用商店 ============
CONFIG_PACKAGE_luci-app-store=y

# ============ OpenAppFilter 应用过滤 ============
CONFIG_PACKAGE_luci-app-openappfilter=y
CONFIG_PACKAGE_openappfilter=y

# ============ Gecoos AC 控制器 ============
CONFIG_PACKAGE_luci-app-gecoosac=y

# ============ Harbor File 文件管理器 ============
CONFIG_PACKAGE_luci-app-harbor-file=y

# ============ 关闭与 NSS 冲突的选项 ============
# NSS 启用时，以下必须关闭
# CONFIG_PACKAGE_luci-app-flowoffload is not set
# CONFIG_PACKAGE_luci-app-sfe is not set
# CONFIG_PACKAGE_kmod-shortcut-fe is not set

# ============ 默认设置 ============
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
